{
  "editor.minimap.enabled": false,
  "workbench.editor.enablePreview": false,
  "editor.fontFamily": "Maple Mono NF",
  "terminal.integrated.fontFamily": "Maple Mono NF",
  "editor.fontSize": 15,
  "terminal.integrated.fontSize": 14,
  "editor.lineHeight": 24,
  "editor.fontWeight": "400",
  "editor.fontLigatures": true,
  "editor.cursorBlinking": "expand",
  "editor.cursorStyle": "line-thin",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "editor.mouseWheelZoom": true,
  "editor.wordWrap": "off",
  "editor.renderWhitespace": "selection",
  "editor.renderControlCharacters": false,
  "editor.quickSuggestions": {
    "other": "on",
    "comments": "on",
    "strings": "on"
  },
  "editor.guides.indentation": true,
  "editor.guides.highlightActiveIndentation": true,
  "editor.guides.bracketPairs": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.stickyScroll.enabled": true,
  "editor.lineNumbers": "relative",
  "editor.occurrencesHighlight": "singleFile",
  "editor.selectionHighlight": true,
  "editor.inlineSuggest.enabled": true,
  "editor.linkedEditing": true,
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "editor.formatOnSave": true,
  "editor.codeLens": true,
  "editor.inlayHints.enabled": "on",
  "editor.scrollBeyondLastLine": false,
  "editor.copyWithSyntaxHighlighting": false,
  "editor.rulers": [
    100,
    120
  ],
  "editor.rulers.color": "#2a2a2a",
  "editor.mouseWheelScrollSensitivity": 1.2,
  "workbench.list.smoothScrolling": true,
  "workbench.tree.indent": 20,
  "workbench.iconTheme": "material-icon-theme",
  "explorer.compactFolders": false,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "window.commandCenter": false,
  "window.density.editorTabHeight": "compact",
  "window.newWindowProfile": "По умолчанию",
  "breadcrumbs.enabled": true,
  "terminal.integrated.defaultLocation": "editor",
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.gpuAcceleration": "on",
  "diffEditor.ignoreTrimWhitespace": false,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "workbench.colorCustomizations": {
    "editor.background": "#0d0d0d",
    "sideBar.background": "#151515",
    "activityBar.background": "#1a1a1a",
    "panel.background": "#101010",
    "terminal.background": "#000000",
    "terminal.foreground": "#D4D4D4",
    "terminal.border": "#555555",
    "terminalCursor.background": "#FFFFFF",
    "terminalCursor.foreground": "#FFFFFF",
    "activityBar.border": "#555555",
    "sideBar.border": "#555555",
    "panel.border": "#555555",
    "editorGroup.border": "#666666",
    "editorGroupHeader.tabsBorder": "#555555",
    "tab.border": "#444444",
    "tab.activeBorderTop": "#4FC1FF",
    "tab.activeForeground": "#FFFFFF",
    "tab.inactiveForeground": "#888888",
    "editor.lineHighlightBorder": "#5f5f5f",
    "editor.lineHighlightBackground": "#00000000"
  },
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "chat.byokUtilityModelDefault": "mainAgent",
  "chat.utilityModel": "",
  "chat.utilitySmallModel": ""
}
